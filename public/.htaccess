# Apache / cPanel / Shared Hosting Configuration for A2Z Aaradhya
# Hardened for Production Security, Fast Performance & SEO Routing

# 1. Disable Directory Browsing (Prevents directory listing leaks)
Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Permanent 301 Redirect /cgi-bin/ to Root Clean URL
  RewriteRule ^cgi-bin(/.*)?$ https://a2z-aaradhya.com/ [R=301,L]

  # Enforce Non-WWW & HTTPS Canonical Domain
  RewriteCond %{HTTP_HOST} ^www\.a2z-aaradhya\.com$ [NC]
  RewriteRule ^(.*)$ https://a2z-aaradhya.com/$1 [R=301,L]

  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP_HOST} ^a2z-aaradhya\.com$ [NC]
  RewriteRule ^(.*)$ https://a2z-aaradhya.com/$1 [R=301,L]

  # Route all requests to index.html for Single Page Application
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME} !-l
  RewriteRule . /index.html [L]
</IfModule>

# Block Access to Hidden & Sensitive Files (.git, .env, .htaccess, backup files)
<FilesMatch "(^\.|\.(bak|config|sql|fla|psd|ini|log|sh|inc|swp|dist|env)$)">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# Browser Caching for Fast Performance & Core Web Vitals
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"

  # Images, Icons and SVGs
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"

  # CSS, JavaScript & Fonts
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"

  # HTML & LLMs context
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/plain "access plus 1 hour"
</IfModule>

# Gzip / Deflate Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json image/svg+xml
</IfModule>

# Security Headers (Defense in depth against Clickjacking, MIME sniffing, XSS, and Protocol Downgrades)
<IfModule mod_headers.c>
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-XSS-Protection "1; mode=block"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" env=HTTPS
</IfModule>
